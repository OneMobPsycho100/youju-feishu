# 默认独立演示，真实部署改为 live；两种模式使用不同的数据库及文件卷。
APP_MODE=demo
APP_PORT=18080
APP_PUBLIC_URL=http://localhost:18080
# 仅 development 测试环境可启用指定公网 HTTP 地址；正式环境保持 false。
ALLOW_INSECURE_HTTP=false
# compose.test.yaml 默认只监听回环地址，公网测试可显式设为 0.0.0.0。
APP_BIND_ADDRESS=127.0.0.1
SESSION_SECRET=demo-only-change-this-before-live-deployment

# SQLite 数据库由 Compose 挂载到 /data/db，演示与真实模式使用独立卷。
# 后台任务由 API 内置线程执行，无需外部消息队列。

# 自动增量补偿同步首次在“运行与模型”保存前的默认值，保存后以工作台配置为准。
# 间隔为整数秒，范围 1 至 86400；关闭自动同步后仍可在审批列表手动触发。
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=300

# 腾讯云发票 OCR 默认关闭，在「系统管理 → 运行与模型」配置。

# 仅兼容旧部署：新安装通过网页填写飞书配置，不再要求设置以下变量。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_TENANT_KEY=
FEISHU_ADMIN_OPEN_IDS=
FEISHU_FILE_HOST_SUFFIXES=feishu.cn,feishucdn.com,feishucdn.cn,byteimg.com,volces.com,larksuite.com,feishu-3rd-party-domain.com

# 演示环境不应录入真实密钥；新真实部署会在独立配置卷生成实例密钥，旧部署沿用原 SESSION_SECRET。
# 可选，支持流式 Chat Completions 的模型接口，BASE_URL 包含 /v1 等供应商前缀。
# 仅在工作台首次保存模型配置前回退这些变量，保存后以数据库为准。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# 业务 Agent 独立于审批任务线程；会话目录自动保存在 SQLite 卷的 agent/ 下。
AGENT_MAX_CONCURRENCY=2
AGENT_TURN_SECONDS=180
